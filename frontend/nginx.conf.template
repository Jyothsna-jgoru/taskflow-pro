server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 'ok';
  }

  location /api/ {
    proxy_pass ${BACKEND_URL};
    # Preserve the API service hostname. Sending the public frontend hostname
    # makes Render route this request back to the frontend and causes a loop.
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_ssl_server_name on;
  }

  location /actuator/ { proxy_pass ${BACKEND_URL}; proxy_ssl_server_name on; }
  location /swagger-ui/ { proxy_pass ${BACKEND_URL}; proxy_ssl_server_name on; }
  location = /swagger-ui.html { proxy_pass ${BACKEND_URL}; proxy_ssl_server_name on; }
  location /v3/api-docs { proxy_pass ${BACKEND_URL}; proxy_ssl_server_name on; }

  location / {
    try_files $uri $uri/ /index.html;
  }

  location ~* \.(?:js|css|svg|png|jpg|jpeg|gif|ico|woff2?)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }
}
